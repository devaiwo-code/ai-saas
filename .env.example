# Port the API listens on (1-65535).
PORT=4000
# Host/interface the API binds to.
HOST=127.0.0.1
# Storage backend: "memory" (no database needed) or "prisma".
STORAGE=memory
# Log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# Optional GitHub personal access token. Leave empty to run without one.
GITHUB_TOKEN=
# Optional database connection URL, required only when STORAGE=prisma (later stories).
DATABASE_URL=
